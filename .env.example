# Copie para .env (que é ignorado pelo git) ou defina as variáveis no terminal.
DB_URL=jdbc:postgresql://localhost:5432/fast_checkin
DB_USERNAME=fast_checkin
DB_PASSWORD=troque-por-uma-senha-local
# 32 bytes aleatórios em Base64 (veja o README para gerar). Nunca versione a chave real.
PERSONAL_DATA_ENCRYPTION_KEY=
# Autenticação (M12). JWT_SECRET: 32 bytes ou mais em Base64 (veja o README). Obrigatório.
JWT_SECRET=
JWT_TTL_MINUTES=60
# Opcional: cria o primeiro ADMIN quando ainda não existe nenhum usuário.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Privacidade (M13): prazo de retenção em dias (padrão 1825) e cron da limpeza diária (padrão 3h).
RETENTION_DAYS=1825
RETENTION_CRON=0 0 3 * * *
# Serviço de OCR (M15): endereço, chave (a mesma OCR_API_KEY do serviço), motor e limites.
OCR_URL=http://127.0.0.1:8001
OCR_API_KEY=
OCR_ENGINE=auto
OCR_TIMEOUT_SECONDS=30
OCR_MAX_IMAGE_BYTES=8388608
